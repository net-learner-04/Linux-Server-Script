# Discord web hook.
WEBHOOK=

# Custom tag for tracking sensitive file access (/etc/passwd) to trigger instant Discord alerts.
FILE_KEY=my_secret_key

# Custom tag for filtering all executed commands (execve system call) to analyze suspicious behavior.
EXEC_KEY=my_exec_key

# Absolute Path for Audit Log Generation. 
# ex) /var/log/audit/audit.log
AUDIT_LOG_PATH=
