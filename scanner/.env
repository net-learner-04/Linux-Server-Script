# Input your discord server web hook.
DISCORD_WEB_HOOK=

# Enter the network range to scan.
SUBNET=

# Enter the path to the JSON file where you want to save the “devices.”
# Recommendation for absolute paths: When running via cron, 
# the working directory may not be where the user expects it to be; 
# therefore, using a relative path (“devices.json”) may result in files 
# being created in the wrong location or not being found.
# ex) /home/(user name)/device_scanner/devices.json
DEVICES_FILE=

# Enter the MAC address of your network interface.
SERVER_MAC=

# Enter the path where the lock file to prevent duplicate execution will be created.
LOCK_FILE=/tmp/scanner.lock
